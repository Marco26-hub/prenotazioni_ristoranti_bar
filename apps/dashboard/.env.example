# Stessa connection string di apps/guest — Neon o Supabase, funziona identica
DATABASE_URL=

# Chiave firma sessioni JWT Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET=

# Stripe secret key piattaforma — serve per creare/leggere gli account
# Connect Express dei locali (onboarding pagamenti in Impostazioni).
STRIPE_SECRET_KEY=

# URL pubblico di questa dashboard (per i redirect di ritorno da Stripe)
APP_URL=http://localhost:3011

# URL pubblico dell'app guest (apps/guest) — usato per generare i QR dei tavoli
GUEST_APP_URL=http://localhost:3010
