# Connection string Neon (o qualunque Postgres), con ?sslmode=require
DATABASE_URL=

# Stripe (rail pagamento principale)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Da Stripe Dashboard -> Developers -> Webhooks -> endpoint /api/webhooks/stripe
# IMPORTANTE: deve essere un "Connect webhook" (eventi degli account collegati),
# non un webhook sulla piattaforma diretta — i PaymentIntent sono creati sugli
# account Connect dei singoli locali.
STRIPE_WEBHOOK_SECRET=
INVOICETRONIC_WEBHOOK_SECRET=

# Chiamate pianificate (promemoria del giorno prima). Vercel lo manda come
# Authorization: Bearer. Senza, i promemoria non partono e il log lo dice.
CRON_SECRET=

# Indirizzo pubblico dell'app cliente: finisce nei link di disdetta via email.
NEXT_PUBLIC_APP_URL=http://localhost:3010
